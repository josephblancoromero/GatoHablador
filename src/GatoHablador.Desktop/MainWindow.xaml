<Window x:Class="GatoHablador.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GatoHablador" Height="650" Width="980" MinHeight="480" MinWidth="760"
        Background="#10151C" Foreground="#F2F5F7" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="GatoHablador" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="Traductor local de chat · prototipo GHP/1" Foreground="#AEB8C2" FontSize="14" />
        </StackPanel>

        <Border Grid.Row="1" Background="#18212B" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Desplazamiento X" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="OffsetXBox" Grid.Column="1" Text="0" Padding="7" Margin="0,0,16,0" />
                <TextBlock Grid.Column="2" Text="Y" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="OffsetYBox" Grid.Column="3" Text="0" Padding="7" Margin="0,0,16,0" />
                <TextBlock Grid.Column="4" Text="Tamaño de celda" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="CellSizeBox" Grid.Column="5" Text="2" Padding="7" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <Button x:Name="StartButton" Content="Iniciar" Click="StartButton_Click" Background="#55D6BE" Foreground="#07110F" FontWeight="SemiBold" />
            <Button x:Name="StopButton" Content="Detener" Click="StopButton_Click" IsEnabled="False" />
            <Button Content="Limpiar" Click="ClearButton_Click" />
            <TextBlock x:Name="StatusText" Text="Esperando" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#AEB8C2" />
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Messages}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#121A22" Foreground="#F2F5F7"
                  BorderBrush="#263544" RowBackground="#121A22" AlternatingRowBackground="#17212B"
                  HorizontalGridLinesBrush="#263544" VerticalGridLinesBrush="#263544">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Hora" Binding="{Binding Time}" Width="76" />
                <DataGridTextColumn Header="Jugador" Binding="{Binding Author}" Width="160" />
                <DataGridTextColumn Header="Original" Binding="{Binding Original}" Width="*" />
                <DataGridTextColumn Header="Español" Binding="{Binding Translation}" Width="*" />
                <DataGridTextColumn Header="Motor" Binding="{Binding Engine}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Margin="0,14,0,0" Foreground="#7F8C98" TextWrapping="Wrap"
                   Text="No lee memoria, no inyecta código y no envía mensajes. El glosario de esta fase solo traduce frases comunes." />
    </Grid>
</Window>

